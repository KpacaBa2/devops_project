# =============================================================================
# Пример переменных окружения (.env.example)
# ВНИМАНИЕ: Никогда не коммитьте реальный .env и секреты в Git!
# Скопируйте этот файл: cp .env.example .env
# =============================================================================

# Режим работы окружения: development | test | production
NODE_ENV=development

# Домен для Caddy (для локального запуска: localhost, для VPS: ваш-домен.ru)
DOMAIN=localhost

# Внешние порты proxy на хосте (по умолчанию 18081 и 18443, чтобы не конфликтовать с чужими сервисами)
CPV1_HTTP_PORT=18081
CPV1_HTTPS_PORT=18443

# Разрешенный Origin для проверки CSRF на эндпоинтах /api/auth/*
APP_ORIGIN=http://localhost:18081

# Режим адаптера хранилища по умолчанию для фронтенда:
# gdrive  — реальный Google Drive API напрямую из браузера
# sandbox — простой REST /api/sandbox/objects (для CI/CD и локальных тестов без Google)
STORAGE_MODE=sandbox

# Данные тестового приложения из Google Cloud Console (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your-test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-test-client-secret
GOOGLE_REDIRECT_URI=postmessage

# 32-байтный ключ (в hex, 64 символа) для серверного шифрования HttpOnly cookie с refresh_token
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Максимальный размер одного зашифрованного объекта (по умолчанию 5 МБ = 5242880 байт)
MAX_UPLOAD_BYTES=5242880
